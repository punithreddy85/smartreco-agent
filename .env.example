# Copy to .env and fill in MESH_API_KEY. Everything else is defaulted for local Docker Compose.

# --- Server ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
PYTHON_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000

# --- Database ---
# Local Docker Compose (direct connection, prepared statements OK):
DATABASE_URL=postgresql://postgres:postgres@db:5432/smartreco
DB_DISABLE_PREPARE=false
# Supabase in production, use the transaction pooler (port 6543) instead, and flip this to true:
# DATABASE_URL=postgresql://postgres:<password>@<project>.pooler.supabase.com:6543/postgres
# DB_DISABLE_PREPARE=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Mesh API (mandatory gateway for every LLM / embedding call) ---
# Create a key at https://meshapi.ai (starts with rsk_)
MESH_API_KEY=rsk_replace_me
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=google/gemini-3-flash-preview
MESH_CHEAP_MODEL=google/gemini-3-flash-preview
MESH_EMBED_MODEL=qwen/text-embedding-v4
MESH_EMBED_DIMENSIONS=1536

# --- Auth / sessions ---
SESSION_SECRET=dev-secret-change-me
SESSION_COOKIE_NAME=smartreco_session

# --- Cron (pg_cron/pg_net in prod; driven by `make cron-*` locally) ---
CRON_SECRET=dev-cron-secret-change-me

# --- Email (scheduled digest bonus, optional) ---
# RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=SmartReco <onboarding@resend.dev>
